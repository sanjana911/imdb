#api call for list movie

###
GET http://127.0.0.1:8000/movies/
Accept: application/json

###
POST http://127.0.0.1:8000/movies/
Content-Type: application/json

{
    "title":"thattathin marayathu",
    "director":"vineeth srinavasan",
    "year":2012,
    "language":"malayalam",
    "genre":"romantic",
    "duration":2.06
}


#api call for retrieve movies

###
GET http://127.0.0.1:8000/movies/2/
Accept: application/json

#api call for update movie

###
PUT http://127.0.0.1:8000/movies/3/
Content-Type: application/json

{
    "title": "ambili",
    "director": "johnpaul",
    "year": 2019,
    "language": "malayalam",
    "genre": "comedy",
    "duration": 2.02
}

#api call for delete movie

###
DELETE http://127.0.0.1:8000/movies/4/
Accept: application/json